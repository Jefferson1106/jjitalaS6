<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="jjitalaS6.Views.vEstudiante"
    Title="Estudiantes"
    BackgroundColor="{StaticResource StudentBackground}">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="15">

        <!-- Título principal -->
        <Label
            Grid.Row="0"
            Text="Semana 6: Servicios web - Estudiantes"
            FontSize="22"
            FontAttributes="Bold"
            TextColor="{StaticResource StudentText}"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"/>

        <!-- Botón para agregar estudiante -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto">

            <Label
                Grid.Column="0"
                Text="Listado de estudiantes"
                FontSize="17"
                FontAttributes="Bold"
                TextColor="{StaticResource StudentText}"
                VerticalOptions="Center"/>

            <Button
                Grid.Column="1"
                x:Name="btnAgregar"
                Text="+ Agregar estudiante"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="8"
                Padding="16,12"
                Clicked="btnAgregar_Clicked"/>

        </Grid>

        <!-- Encabezado de tabla -->
        <Border
            Grid.Row="2"
            BackgroundColor="{StaticResource Tertiary}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 8"
            Padding="15">

            <Grid ColumnDefinitions="*,*,70"
                  ColumnSpacing="10">

                <Label
                    Grid.Column="0"
                    Text="NOMBRE"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Label
                    Grid.Column="1"
                    Text="APELLIDO"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="White"/>
                <Label
                    Grid.Column="2"
                    Text="EDAD"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"/>

            </Grid>
        </Border>

        <!-- Lista de estudiantes -->
        <CollectionView
            Grid.Row="3"
            x:Name="listaEstudiante"
            SelectionMode="Single"
            SelectionChanged="listaEstudiante_SelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        BackgroundColor="{StaticResource StudentSurface}"
                        Stroke="{StaticResource StudentBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 5"
                        Margin="0,2"
                        Padding="15">

                        <Grid ColumnDefinitions="*,*,70"
                              ColumnSpacing="10">

                            <Label
                                Grid.Column="0"
                                Text="{Binding nombre}"
                                FontSize="15"
                                TextColor="{StaticResource StudentText}"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="{Binding apellido}"
                                FontSize="15"
                                TextColor="{StaticResource StudentMuted}"
                                VerticalOptions="Center"/>
                            <Label
                                Grid.Column="2"
                                Text="{Binding edad}"
                                FontSize="15"
                                TextColor="{StaticResource StudentText}"
                                HorizontalTextAlignment="Center"
                                VerticalOptions="Center"/>

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label
                    Text="No hay estudiantes registrados."
                    TextColor="{StaticResource StudentMuted}"
                    HorizontalOptions="Center"
                    Margin="0,20"/>
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>
</ContentPage>
